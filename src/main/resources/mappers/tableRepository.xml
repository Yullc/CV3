<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.CV3.repository.tableRepository">

    <select id="findByType" resultType="com.example.CV3.vo.table">
        SELECT
        id,
        title,
        category,
        broadcast_time,
        views,
        sales,
        revenue,
        product_count,
        type
        FROM `table`
        WHERE type = #{type}
    </select>

</mapper>